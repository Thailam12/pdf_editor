<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDFEditor.Views.AIView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE9D9;" FontSize="18"
                          Foreground="{ThemeResource SystemAccentColor}" />
                <TextBlock Text="AI Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="&#xE711;"
                    Style="{StaticResource SubtleButtonStyle}" Width="28"
                    Click="OnCloseClick" />
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="1" Padding="8" Margin="0,0,0,8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="StatusDot" Width="8" Height="8"
                         Fill="{ThemeResource SystemAccentColor}" />
                <TextBlock x:Name="StatusText" Text="PDFMind 100M Ready"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Quick Actions -->
        <StackPanel x:Name="QuickActions" Grid.Row="2" Orientation="Horizontal"
                    Spacing="4" Margin="0,0,0,8" HorizontalAlignment="Center">
            <Button Style="{StaticResource SubtleButtonStyle}" Click="OnSummarizeClick"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8F1;" FontSize="12" />
                    <TextBlock Text="Summarize" FontSize="11" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}" Click="OnTranslateClick"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE774;" FontSize="12" />
                    <TextBlock Text="Translate" FontSize="11" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}" Click="OnRedactClick"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE75D;" FontSize="12" />
                    <TextBlock Text="Redact" FontSize="11" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Chat Messages -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ChatMessages" Spacing="12" Padding="4">
                <Grid x:Name="WelcomeMessage">
                    <Grid.Background>
                        <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.5" />
                    </Grid.Background>
                    <StackPanel Margin="12" Spacing="8">
                        <TextBlock Text="Welcome to PDFMind AI"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="I can help you understand, analyze, and edit your PDF documents. Ask me anything about your document."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Input Area -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryInput" PlaceholderText="Ask about this PDF..."
                     KeyDown="OnQueryKeyDown" MinHeight="36"
                     Padding="8,6" />
            <Button x:Name="SendBtn" Grid.Column="1" Content="&#xE724;"
                    Style="{StaticResource AccentButtonStyle}"
                    Margin="8,0,0,0" Width="36" Height="36"
                    Click="OnSendClick" />
        </Grid>
    </Grid>
</UserControl>
