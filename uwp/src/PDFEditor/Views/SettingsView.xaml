<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDFEditor.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="24,16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Center">

                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- Appearance -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox x:Name="ThemeCombo" Width="200"
                                      SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="Dark" IsSelected="True" Tag="Dark" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="System" Tag="System" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Editor -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Editor" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default Zoom Level" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <Slider x:Name="DefaultZoomSlider" Grid.Column="1"
                                        Minimum="25" Maximum="400" Value="100" Width="200"
                                        ValueChanged="OnDefaultZoomChanged" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Measurement Unit" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ComboBox x:Name="UnitCombo" Grid.Column="1" Width="150">
                                    <ComboBoxItem Content="Millimeters" IsSelected="True" />
                                    <ComboBoxItem Content="Centimeters" />
                                    <ComboBoxItem Content="Inches" />
                                    <ComboBoxItem Content="Points" />
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show Grid Lines" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ToggleSwitch x:Name="GridToggle" Grid.Column="1"
                                              Toggled="OnGridToggleChanged" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Snap to Grid" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ToggleSwitch x:Name="SnapToggle" Grid.Column="1"
                                              Toggled="OnSnapToggleChanged" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="High Quality Rendering" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ToggleSwitch x:Name="HQRenderToggle" Grid.Column="1"
                                              IsOn="True"
                                              Toggled="OnHQRenderToggleChanged" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Auto Save -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Auto Save" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Enable Auto Save" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ToggleSwitch x:Name="AutoSaveToggle" Grid.Column="1"
                                              IsOn="True" Toggled="OnAutoSaveToggled" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Save Interval (seconds)" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBox x:Name="AutoSaveIntervalBox" Grid.Column="1"
                                         Width="80" Text="300" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- AI -->
                <StackPanel Spacing="8">
                    <TextBlock Text="AI Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Enable AI Features" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ToggleSwitch x:Name="AIToggle" Grid.Column="1"
                                              Toggled="OnAIToggled" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Server URL" Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBox x:Name="AIServerUrlBox" Text="http://localhost:8080"
                                         Width="300" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Model" Style="{StaticResource BodyTextBlockStyle}" />
                                <ComboBox x:Name="AIModelCombo" Width="300">
                                    <ComboBoxItem Content="PDFMind 100M (Recommended)" IsSelected="True" />
                                    <ComboBoxItem Content="PDFMind 7B" />
                                    <ComboBoxItem Content="Custom" />
                                </ComboBox>
                            </StackPanel>

                            <Button Content="Test Connection" Padding="12,4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnTestConnectionClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- About -->
                <StackPanel Spacing="8">
                    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PDF Editor Pro" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Version 2.1" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Built with WinUI 3, Direct2D, and PDFMind AI"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="A professional PDF editor powered by native Windows rendering and AI-assisted document analysis."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="400" />
                            <StackPanel Spacing="4" Margin="0,8,0,0">
                                <TextBlock Text="What’s new in 2.1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="• Improved OCR feedback and diagnostics"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="• Faster startup and health reporting"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="• Better cloud sync readiness"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" Margin="0,8,0,24">
                    <Button Content="Save Settings" Style="{StaticResource AccentButtonStyle}"
                            Padding="24,8" Click="OnSaveClick" />
                    <Button Content="Reset to Defaults" Padding="24,8"
                            Click="OnResetClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
