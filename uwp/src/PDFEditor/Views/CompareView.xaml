<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDFEditor.Views.CompareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Document Comparison" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!-- File Selection -->
        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Left Document"
                       Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Right Document"
                       Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4" />

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,6">
                    <TextBlock x:Name="LeftFileText" Text="No file selected"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <Button Grid.Column="1" Content="..." Margin="4,0,0,0"
                        Style="{StaticResource SubtleButtonStyle}" Width="32"
                        Click="OnBrowseLeftClick" />
            </Grid>

            <FontIcon Grid.Row="1" Grid.Column="1" Glyph="&#xE8EF;" FontSize="20"
                      VerticalAlignment="Center" Margin="8,0"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Grid Grid.Row="1" Grid.Column="2" Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,6">
                    <TextBlock x:Name="RightFileText" Text="No file selected"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <Button Grid.Column="1" Content="..." Margin="4,0,0,0"
                        Style="{StaticResource SubtleButtonStyle}" Width="32"
                        Click="OnBrowseRightClick" />
            </Grid>

            <Button Grid.Row="2" Grid.ColumnSpan="3" x:Name="CompareBtn"
                    Content="Compare Documents" Margin="0,8,0,0"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Padding="24,8"
                    Click="OnCompareClick" />
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftPreview" Grid.Column="0" Margin="0,0,4,0"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="4">
                <TextBlock Text="Left Preview" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <Grid x:Name="RightPreview" Grid.Column="2" Margin="4,0,0,0"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="4">
                <TextBlock Text="Right Preview" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <Grid Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center"
                  VerticalAlignment="Top" Margin="0,8,0,0">
                <TextBlock x:Name="DiffSummaryText" Text="Select two documents to compare"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
