<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDFEditor.Views.PagePanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Pages" Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button x:Name="CollapseBtn" Grid.Column="1" Content="&#xE76E;"
                    Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28"
                    Click="OnCollapseClick" />
        </Grid>

        <!-- View Mode -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Padding="12,0,12,8" Spacing="4">
            <ToggleButton x:Name="ThumbnailViewBtn" IsChecked="True"
                          Style="{StaticResource SubtleToggleButtonStyle}" Padding="8,4"
                          ToolTipService.ToolTip="Thumbnails">
                <FontIcon Glyph="&#xE8A9;" FontSize="12" />
            </ToggleButton>
            <ToggleButton x:Name="ListViewBtn"
                          Style="{StaticResource SubtleToggleButtonStyle}" Padding="8,4"
                          ToolTipService.ToolTip="List View">
                <FontIcon Glyph="&#xE8EF;" FontSize="12" />
            </ToggleButton>
        </StackPanel>

        <!-- Thumbnails Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="ThumbnailsList" Margin="8,0,8,8">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Margin="0,0,0,8" Padding="4"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="4"
                              PointerPressed="OnThumbnailClick">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="2" Background="White"
                                    Margin="4,4,4,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F5F5F5" Offset="0" />
                                        <GradientStop Color="#FAFAFA" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="PDF" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#CCCCCC" FontSize="11" />
                            </Border>
                            <TextBlock Grid.Row="1" x:Name="PageLabel" Text="Page 1"
                                       HorizontalTextAlignment="Center" Padding="0,4"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
