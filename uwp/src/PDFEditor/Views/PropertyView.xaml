<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDFEditor.Views.PropertyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Properties" Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="&#xE711;"
                    Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28"
                    Click="OnCollapseClick" />
        </Grid>

        <!-- No Selection -->
        <StackPanel x:Name="NoSelectionPanel" Grid.Row="1" Margin="12,8" Spacing="12">
            <TextBlock Text="Document Properties"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <TextBlock Text="File:" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="FileNameText" Text="No document loaded"
                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Pages:" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="PageCountText" Text="0"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Size:" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="FileSizeText" Text="--"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Modified:" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ModifiedText" Text="No"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Selection Properties (shown when element is selected) -->
        <ScrollViewer x:Name="SelectionPropsPanel" Grid.Row="2" Margin="12,0"
                      Visibility="Collapsed">
            <StackPanel Spacing="12">
                <TextBlock Text="Element Properties"
                           Style="{StaticResource SubtitleTextBlockStyle}" />

                <!-- Position -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Position" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="X:" Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="PosXBox" Grid.Row="0" Grid.Column="1"
                                 Margin="4,0,0,4" />

                        <TextBlock Text="Y:" Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="PosYBox" Grid.Row="1" Grid.Column="1"
                                 Margin="4,0,0,4" />

                        <TextBlock Text="W:" Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="PosWBox" Grid.Row="2" Grid.Column="1"
                                 Margin="4,0,0,4" />
                    </Grid>
                </StackPanel>

                <!-- Appearance -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Fill:" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="FillColorBtn" Style="{StaticResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="20" Height="20" CornerRadius="4"
                                    Background="{ThemeResource SystemAccentColor}" />
                            <TextBlock Text="Change Color" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Opacity:" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100"
                            Width="150" />
                </StackPanel>

                <!-- Text Properties -->
                <StackPanel x:Name="TextPropsPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Text" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Font:" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox x:Name="TextFontCombo" Width="150">
                        <ComboBoxItem Content="Arial" IsSelected="True" />
                        <ComboBoxItem Content="Times New Roman" />
                        <ComboBoxItem Content="Calibri" />
                        <ComboBoxItem Content="Helvetica" />
                    </ComboBox>

                    <TextBlock Text="Size:" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox x:Name="TextSizeBox" Width="60" Text="12" />

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                        <ToggleButton Style="{StaticResource SubtleToggleButtonStyle}">
                            <TextBlock Text="B" FontWeight="Bold" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource SubtleToggleButtonStyle}">
                            <TextBlock Text="I" FontStyle="Italic" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource SubtleToggleButtonStyle}">
                            <TextBlock Text="U" TextDecorations="Underline" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
