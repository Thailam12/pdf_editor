<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDFEditor.Views.LayersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Layers" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
            <Button Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Add Layer">
                <FontIcon Glyph="&#xE710;" FontSize="12" />
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Delete Layer">
                <FontIcon Glyph="&#xE74D;" FontSize="12" />
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Move Up">
                <FontIcon Glyph="&#xE73E;" FontSize="12" />
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Move Down">
                <FontIcon Glyph="&#xE73D;" FontSize="12" />
            </Button>
        </StackPanel>

        <ListView x:Name="LayersList" Grid.Row="2" Margin="0,8,0,0"
                  SelectionMode="Single">
            <ListViewItem Content="Background Layer" IsChecked="True">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="True" />
                    <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                    <TextBlock Text="Background" VerticalAlignment="Center" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Content="Content Layer">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="True" />
                    <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                    <TextBlock Text="Content" VerticalAlignment="Center" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Content="Annotations Layer">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="True" />
                    <FontIcon Glyph="&#xE70B;" FontSize="14" />
                    <TextBlock Text="Annotations" VerticalAlignment="Center" />
                </StackPanel>
            </ListViewItem>
        </ListView>
    </Grid>
</UserControl>
