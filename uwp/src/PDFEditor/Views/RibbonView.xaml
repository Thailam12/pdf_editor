<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PDFEditor.Views.RibbonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tab Headers -->
        <Grid Grid.Row="0" Padding="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TabHeaders" Grid.Column="0" Orientation="Horizontal"
                        Margin="4,2,0,0" Spacing="0">
                <Button x:Name="FileTabBtn" Content="File" Click="OnTabClick"
                        Style="{StaticResource SubtleButtonStyle}" Padding="12,6" Tag="File" />
                <Button x:Name="HomeTabBtn" Content="Home" Click="OnTabClick"
                        Style="{StaticResource SubtleButtonStyle}" Padding="12,6" Tag="Home"
                        FontWeight="SemiBold" />
                <Button x:Name="InsertTabBtn" Content="Insert" Click="OnTabClick"
                        Style="{StaticResource SubtleButtonStyle}" Padding="12,6" Tag="Insert" />
                <Button x:Name="AnnotateTabBtn" Content="Annotate" Click="OnTabClick"
                        Style="{StaticResource SubtleButtonStyle}" Padding="12,6" Tag="Annotate" />
                <Button x:Name="PageTabBtn" Content="Page" Click="OnTabClick"
                        Style="{StaticResource SubtleButtonStyle}" Padding="12,6" Tag="Page" />
                <Button x:Name="ViewTabBtn" Content="View" Click="OnTabClick"
                        Style="{StaticResource SubtleButtonStyle}" Padding="12,6" Tag="View" />
                <Button x:Name="ToolsTabBtn" Content="Tools" Click="OnTabClick"
                        Style="{StaticResource SubtleButtonStyle}" Padding="12,6" Tag="Tools" />
                <Button x:Name="HelpTabBtn" Content="Help" Click="OnTabClick"
                        Style="{StaticResource SubtleButtonStyle}" Padding="12,6" Tag="Help" />
            </StackPanel>

            <Button x:Name="AIBtn" Grid.Column="1" HorizontalAlignment="Right"
                    Content="AI Assistant" Click="OnAIClick"
                    Style="{StaticResource AccentButtonStyle}" Margin="8,2"
                    Padding="12,4">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                        <TextBlock Text="AI Assistant" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <!-- Ribbon Content Area -->
        <Grid Grid.Row="1" Padding="4,2,4,4" MinHeight="60">
            <!-- Home Tab Content -->
            <StackPanel x:Name="HomeTabContent" Orientation="Horizontal" Spacing="2">
                <!-- Clipboard Group -->
                <StackPanel Orientation="Horizontal" Spacing="2" Padding="4,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0" Margin="0,0,4,0">
                    <Button ToolTipService.ToolTip="Cut (Ctrl+X)" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE8C6;" FontSize="16" />
                    </Button>
                    <Button ToolTipService.ToolTip="Copy (Ctrl+C)" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    </Button>
                    <Button ToolTipService.ToolTip="Paste (Ctrl+V)" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE77F;" FontSize="16" />
                    </Button>
                </StackPanel>

                <!-- Select Group -->
                <StackPanel Orientation="Horizontal" Spacing="2" Padding="4,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0" Margin="0,0,4,0">
                    <ToggleButton x:Name="SelectToolBtn" IsChecked="True"
                                  ToolTipService.ToolTip="Select Tool"
                                  Style="{StaticResource SubtleToggleButtonStyle}">
                        <FontIcon Glyph="&#xE722;" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="TextToolBtn"
                                  ToolTipService.ToolTip="Text Tool"
                                  Style="{StaticResource SubtleToggleButtonStyle}">
                        <FontIcon Glyph="&#xE8D2;" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="HandToolBtn"
                                  ToolTipService.ToolTip="Hand Tool"
                                  Style="{StaticResource SubtleToggleButtonStyle}">
                        <FontIcon Glyph="&#xE922;" FontSize="16" />
                    </ToggleButton>
                </StackPanel>

                <!-- Format Group -->
                <StackPanel Orientation="Horizontal" Spacing="2" Padding="4,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0" Margin="0,0,4,0">
                    <ComboBox x:Name="FontFamilyCombo" Width="140" PlaceholderText="Font">
                        <ComboBoxItem Content="Arial" IsSelected="True" />
                        <ComboBoxItem Content="Times New Roman" />
                        <ComboBoxItem Content="Calibri" />
                        <ComboBoxItem Content="Segoe UI" />
                        <ComboBoxItem Content="Helvetica" />
                        <ComboBoxItem Content="Courier New" />
                    </ComboBox>
                    <ComboBox x:Name="FontSizeCombo" Width="60" PlaceholderText="Size">
                        <ComboBoxItem Content="8" />
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="12" IsSelected="True" />
                        <ComboBoxItem Content="14" />
                        <ComboBoxItem Content="16" />
                        <ComboBoxItem Content="18" />
                        <ComboBoxItem Content="24" />
                        <ComboBoxItem Content="36" />
                        <ComboBoxItem Content="48" />
                        <ComboBoxItem Content="72" />
                    </ComboBox>
                    <ToggleButton x:Name="BoldBtn" ToolTipService.ToolTip="Bold (Ctrl+B)"
                                  Style="{StaticResource SubtleToggleButtonStyle}">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="ItalicBtn" ToolTipService.ToolTip="Italic (Ctrl+I)"
                                  Style="{StaticResource SubtleToggleButtonStyle}">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="UnderlineBtn" ToolTipService.ToolTip="Underline (Ctrl+U)"
                                  Style="{StaticResource SubtleToggleButtonStyle}">
                        <TextBlock Text="U" TextDecorations="Underline" FontSize="14" />
                    </ToggleButton>
                    <Button x:Name="FontColorBtn" ToolTipService.ToolTip="Font Color"
                            Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel>
                            <FontIcon Glyph="&#xE790;" FontSize="16" />
                            <Rectangle Height="3" Width="16"
                                       Fill="{ThemeResource SystemAccentColor}" Margin="0,-2,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Drawing Group -->
                <StackPanel Orientation="Horizontal" Spacing="2" Padding="4,0">
                    <Button x:Name="InsertImageBtn" ToolTipService.ToolTip="Insert Image"
                            Style="{StaticResource SubtleButtonStyle}" Click="OnInsertImageClick">
                        <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                    </Button>
                    <Button x:Name="ShapesBtn" ToolTipService.ToolTip="Shapes"
                            Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE787;" FontSize="16" />
                    </Button>
                    <Button x:Name="DrawBtn" ToolTipService.ToolTip="Freehand Draw"
                            Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xEDFB;" FontSize="16" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Insert Tab Content (hidden by default) -->
            <StackPanel x:Name="InsertTabContent" Orientation="Horizontal" Spacing="2"
                        Visibility="Collapsed">
                <Button ToolTipService.ToolTip="Insert Page" Style="{StaticResource SubtleButtonStyle}"
                        Click="OnInsertPageClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7C3;" FontSize="16" />
                        <TextBlock Text="Page" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Insert Image" Style="{StaticResource SubtleButtonStyle}"
                        Click="OnInsertImageClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                        <TextBlock Text="Image" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Insert Text Box" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D2;" FontSize="16" />
                        <TextBlock Text="Text Box" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Add Stamp" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B7;" FontSize="16" />
                        <TextBlock Text="Stamp" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Add Signature" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDA2;" FontSize="16" />
                        <TextBlock Text="Signature" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Add Watermark" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                        <TextBlock Text="Watermark" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Insert Link" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71B;" FontSize="16" />
                        <TextBlock Text="Link" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Annotate Tab Content (hidden by default) -->
            <StackPanel x:Name="AnnotateTabContent" Orientation="Horizontal" Spacing="2"
                        Visibility="Collapsed">
                <Button x:Name="HighlightBtn" ToolTipService.ToolTip="Highlight"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE795;" FontSize="16" />
                        <TextBlock Text="Highlight" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="UnderlineAnnoBtn" ToolTipService.ToolTip="Underline"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8DC;" FontSize="16" />
                        <TextBlock Text="Underline" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="StrikeoutBtn" ToolTipService.ToolTip="Strikeout"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8DB;" FontSize="16" />
                        <TextBlock Text="Strikeout" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="NoteBtn" ToolTipService.ToolTip="Sticky Note"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70B;" FontSize="16" />
                        <TextBlock Text="Note" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="FreehandBtn" ToolTipService.ToolTip="Freehand Drawing"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDFB;" FontSize="16" />
                        <TextBlock Text="Freehand" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="TextBoxBtn" ToolTipService.ToolTip="Text Box"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D2;" FontSize="16" />
                        <TextBlock Text="Text Box" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="EraserBtn" ToolTipService.ToolTip="Eraser"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE94B;" FontSize="16" />
                        <TextBlock Text="Eraser" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Page Tab Content (hidden by default) -->
            <StackPanel x:Name="PageTabContent" Orientation="Horizontal" Spacing="2"
                        Visibility="Collapsed">
                <Button ToolTipService.ToolTip="Insert Page" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7C3;" FontSize="16" />
                        <TextBlock Text="Insert" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Delete Page" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        <TextBlock Text="Delete" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Extract Pages" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                        <TextBlock Text="Extract" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Merge Documents" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                        <TextBlock Text="Merge" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Split Document" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8AD;" FontSize="16" />
                        <TextBlock Text="Split" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="RotateBtn" ToolTipService.ToolTip="Rotate Page"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock Text="Rotate" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="CropBtn" ToolTipService.ToolTip="Crop Page"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE960;" FontSize="16" />
                        <TextBlock Text="Crop" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- View Tab Content (hidden by default) -->
            <StackPanel x:Name="ViewTabContent" Orientation="Horizontal" Spacing="2"
                        Visibility="Collapsed">
                <Button ToolTipService.ToolTip="Zoom In" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                        <TextBlock Text="Zoom In" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Zoom Out" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE738;" FontSize="16" />
                        <TextBlock Text="Zoom Out" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Fit to Width" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9A6;" FontSize="16" />
                        <TextBlock Text="Fit Width" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Full Screen" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE740;" FontSize="16" />
                        <TextBlock Text="Full Screen" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="PageLayoutBtn" ToolTipService.ToolTip="Page Layout"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xECA5;" FontSize="16" />
                        <TextBlock Text="Layout" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Tools Tab Content (hidden by default) -->
            <StackPanel x:Name="ToolsTabContent" Orientation="Horizontal" Spacing="2"
                        Visibility="Collapsed">
                <Button x:Name="OCRBtn" ToolTipService.ToolTip="OCR Text Recognition"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE97B;" FontSize="16" />
                        <TextBlock Text="OCR" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="RedactBtn" ToolTipService.ToolTip="Redact Content"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE75D;" FontSize="16" />
                        <TextBlock Text="Redact" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="CompareBtn" ToolTipService.ToolTip="Compare Documents"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                        <TextBlock Text="Compare" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="CompressBtn" ToolTipService.ToolTip="Compress PDF"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="16" />
                        <TextBlock Text="Compress" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="FormBtn" ToolTipService.ToolTip="Form Editing"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74C;" FontSize="16" />
                        <TextBlock Text="Form" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="SpellCheckBtn" ToolTipService.ToolTip="Spell Check"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D5;" FontSize="16" />
                        <TextBlock Text="Spell Check" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Help Tab Content (hidden by default) -->
            <StackPanel x:Name="HelpTabContent" Orientation="Horizontal" Spacing="2"
                        Visibility="Collapsed">
                <Button ToolTipService.ToolTip="About" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                        <TextBlock Text="About" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Keyboard Shortcuts" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE76E;" FontSize="16" />
                        <TextBlock Text="Shortcuts" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="HelpAIBtn" ToolTipService.ToolTip="AI Assistant"
                        Style="{StaticResource SubtleButtonStyle}" Click="OnAIClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                        <TextBlock Text="AI Assistant" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Check for Updates" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="16" />
                        <TextBlock Text="Updates" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- File Tab Content -->
            <StackPanel x:Name="FileTabContent" Orientation="Horizontal" Spacing="8"
                        Visibility="Collapsed">
                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnNewClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="New" FontWeight="SemiBold" />
                            <TextBlock Text="Create a new document" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnOpenClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="Open" FontWeight="SemiBold" />
                            <TextBlock Text="Open an existing file" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="Save" FontWeight="SemiBold" />
                            <TextBlock Text="Save current file" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE792;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="Print" FontWeight="SemiBold" />
                            <TextBlock Text="Print document" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B1;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="Export" FontWeight="SemiBold" />
                            <TextBlock Text="Export to other formats" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
